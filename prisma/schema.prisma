generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// User role definitions for authorization and ownership.
/// REQUESTER → creates and owns change requests (default)
/// REVIEWER  → reviews, approves, or rejects change requests
/// ADMIN     → administrative system access
enum UserRole {
  REQUESTER
  REVIEWER
  ADMIN
}

/// Lifecycle states a ChangeRequest can move through.
/// DRAFT        → created but not yet submitted
/// UNDER_REVIEW → submitted and awaiting a decision
/// APPROVED     → accepted; work may proceed
/// REJECTED     → declined; request must be revised or closed
/// CLOSED       → terminal state; no further transitions permitted
enum ChangeRequestStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

/// The assessed risk of applying this change.
/// Ordered LOW → CRITICAL so reviewers can set escalation thresholds.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// The AI's suggested next step for a ChangeRequest. This is an assessment
/// only — the AI never approves or rejects a ChangeRequest itself; existing
/// backend business logic (changeService.js) remains the sole authority
/// over ChangeRequest.status.
enum AIRecommendation {
  APPROVE
  CONDITIONAL_APPROVAL
  REQUEST_MORE_EVIDENCE
  REJECT
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// Represents a system user who can create, review, or administer change requests.
model User {
  /// UUID v4 primary key.
  id String @id @default(uuid())

  /// Full name of the user.
  name String

  /// Unique email address used for identity and login.
  email String @unique

  /// Cryptographic hash of the user's password. Plaintext passwords are never stored.
  passwordHash String

  /// User's system role. Defaults to REQUESTER.
  role UserRole @default(REQUESTER)

  /// Record creation timestamp.
  createdAt DateTime @default(now())

  /// Automatically updated on every UPDATE/UPSERT.
  updatedAt DateTime @updatedAt

  /// Change requests created by this user.
  changeRequestsCreated ChangeRequest[]
  evidenceSubmitted     Evidence[]
  auditEvents           AuditEvent[]

  @@map("users")
}

/// A ChangeRequest represents a proposed software or process change that must
/// go through a review and approval lifecycle before it can be implemented.
model ChangeRequest {
  /// UUID v4 — safe to expose in URLs; no row-count leakage.
  id String @id @default(uuid())

  /// Short human-readable label for the request (1–100 chars enforced in middleware).
  title String

  /// Full description of the change, its motivation, and impact.
  /// Nullable at creation time; required before submitting for review (enforced in service layer).
  description String?

  /// Current lifecycle state. Defaults to DRAFT — the author must explicitly
  /// submit the request to move it into UNDER_REVIEW.
  status ChangeRequestStatus @default(DRAFT)

  /// Risk assessment for this change. Defaults to LOW so the author must
  /// actively acknowledge higher risk rather than having it pre-filled.
  riskLevel RiskLevel @default(LOW)

  /// Foreign key referencing the creator User. Nullable for backward compatibility with existing records.
  createdById String?

  /// Relation to the user who created this change request.
  createdBy   User?        @relation(fields: [createdById], references: [id])
  evidence    Evidence[]
  auditEvents AuditEvent[]
  aiAnalyses  AIAnalysis[]
  /// Set by the database on INSERT; immune to client clock skew.
  createdAt   DateTime     @default(now())

  /// Automatically updated by Prisma on every UPDATE/UPSERT.
  updatedAt DateTime @updatedAt

  // ── Indexes ────────────────────────────────────────────────────────────────
  // Each index targets a first-class query pattern on the dashboard:
  //   status      → "show all UNDER_REVIEW requests"
  //   riskLevel   → "show all CRITICAL requests"
  //   createdAt   → paginated list ordered by most-recent
  //   createdById → filter change requests by creator/owner
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
  @@index([createdById])
  // Map to snake_case table name — Prisma model names are PascalCase,
  // PostgreSQL table names are snake_case.
  @@map("change_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Evidence
// ─────────────────────────────────────────────────────────────────────────────

/// Evidence attached to a ChangeRequest to support review and approval.
model Evidence {
  /// UUID v4 primary key.
  id String @id @default(uuid())

  /// ChangeRequest this evidence belongs to.
  changeRequestId String

  /// User who submitted the evidence.
  submittedById String

  /// Evidence category.
  type String

  /// Human-readable evidence title.
  title String

  /// Optional explanatory notes.
  description String?

  /// URL or external reference associated with the evidence.
  reference String

  /// Optional structured metadata.
  metadata Json?

  /// Record creation timestamp.
  createdAt DateTime @default(now())

  /// Automatically updated on every UPDATE.
  updatedAt DateTime @updatedAt

  /// Parent ChangeRequest.
  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  /// User who submitted this evidence.
  submittedBy User @relation(fields: [submittedById], references: [id])

  @@index([changeRequestId])
  @@index([submittedById])
  @@map("evidence")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Events
// ─────────────────────────────────────────────────────────────────────────────

/// Immutable server-generated audit event.
model AuditEvent {
  /// UUID v4 primary key.
  id String @id @default(uuid())

  /// User responsible for the event. Nullable for future system events.
  actorId String?

  /// Action performed, e.g. CHANGE_CREATED, CHANGE_SUBMITTED.
  action String

  /// Entity type associated with this event.
  entityType String

  /// ID of the affected entity.
  entityId String

  /// ChangeRequest associated with the event when applicable.
  changeRequestId String?

  /// Structured event metadata.
  metadata Json?

  /// Event creation timestamp.
  createdAt DateTime @default(now())

  /// Actor responsible for the event.
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Associated ChangeRequest.
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Analysis (Phase 1 — AI foundation)
// ─────────────────────────────────────────────────────────────────────────────

/// A single AI-generated risk assessment for a ChangeRequest.
///
/// Structured, JSON-field-backed by design for this first version rather
/// than fully normalized — see docs/architecture.md for the rationale.
/// The AI provides an assessment only; it never mutates ChangeRequest.status.
model AIAnalysis {
  /// UUID v4 primary key.
  id String @id @default(uuid())

  /// ChangeRequest this analysis was run against.
  changeRequestId String

  /// Parent ChangeRequest.
  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  /// Integer risk score in [0, 100], validated before persistence.
  riskScore Int

  /// Risk level bucket, validated against the RiskLevel enum before persistence.
  riskLevel RiskLevel

  /// Model's self-reported confidence in [0, 1], validated before persistence.
  confidence Float

  /// Concise human-readable summary of the assessment.
  summary String

  /// Array of affected area/system names (JSON — see validation layer in src/ai/schema.js).
  affectedAreas Json

  /// Array of structured { description, severity } findings.
  riskFactors Json

  /// Array of evidence descriptions the AI flagged as missing.
  missingEvidence Json

  /// The AI's suggested next step. Advisory only — never applied automatically.
  recommendation AIRecommendation

  /// Identifies which provider/model produced this analysis, e.g. "openai:gpt-4o-mini"
  /// or "fake:deterministic-v1". Never a secret — no API keys are ever stored here.
  providerModel String

  /// Record creation timestamp.
  createdAt DateTime @default(now())

  @@index([changeRequestId])
  @@index([createdAt])
  @@map("ai_analyses")
}
