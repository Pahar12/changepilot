generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// Lifecycle states a ChangeRequest can move through.
/// DRAFT        → created but not yet submitted
/// UNDER_REVIEW → submitted and awaiting a decision
/// APPROVED     → accepted; work may proceed
/// REJECTED     → declined; request must be revised or closed
/// CLOSED       → terminal state; no further transitions permitted
enum ChangeRequestStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

/// The assessed risk of applying this change.
/// Ordered LOW → CRITICAL so reviewers can set escalation thresholds.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// A ChangeRequest represents a proposed software or process change that must
/// go through a review and approval lifecycle before it can be implemented.
model ChangeRequest {
  /// UUID v4 — safe to expose in URLs; no row-count leakage.
  id          String               @id @default(uuid())

  /// Short human-readable label for the request (1–100 chars enforced in middleware).
  title       String

  /// Full description of the change, its motivation, and impact.
  /// Nullable at creation time; required before submitting for review (enforced in service layer).
  description String?

  /// Current lifecycle state. Defaults to DRAFT — the author must explicitly
  /// submit the request to move it into UNDER_REVIEW.
  status      ChangeRequestStatus  @default(DRAFT)

  /// Risk assessment for this change. Defaults to LOW so the author must
  /// actively acknowledge higher risk rather than having it pre-filled.
  riskLevel   RiskLevel            @default(LOW)

  /// Set by the database on INSERT; immune to client clock skew.
  createdAt   DateTime             @default(now())

  /// Automatically updated by Prisma on every UPDATE/UPSERT.
  updatedAt   DateTime             @updatedAt

  // ── Indexes ────────────────────────────────────────────────────────────────
  // Each index targets a first-class query pattern on the dashboard:
  //   status    → "show all UNDER_REVIEW requests"
  //   riskLevel → "show all CRITICAL requests"
  //   createdAt → paginated list ordered by most-recent
  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])

  // Map to snake_case table name — Prisma model names are PascalCase,
  // PostgreSQL table names are snake_case.
  @@map("change_requests")
}
