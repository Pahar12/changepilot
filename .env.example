PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/changepilot?schema=public"
JWT_SECRET="changepilot-dev-secret-key-replace-in-production"
JWT_EXPIRES_IN=86400
CORS_ORIGIN="http://localhost:3000"

# AI provider used by POST /api/v1/changes/:id/analyze (see src/ai/index.js).
# "fake"   — deterministic, network-free provider. Default. No key needed;
#            this is what the app and test suite use out of the box.
# "openai" — calls OpenAI's Chat Completions API. Requires OPENAI_API_KEY below.
AI_PROVIDER="fake"

# Only required when AI_PROVIDER="openai". Never commit a real key.
OPENAI_API_KEY=""
